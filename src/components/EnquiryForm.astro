---
// Kontaktní formulář. Odesílá přes Web3Forms na e-mail, ke kterému patří klíč.
// Ochrana proti spamu: skryté pole „botcheck“ + captcha podle nastavení webu:
//   hcaptcha  – zdarma (Web3Forms Free), výchozí
//   recaptcha – Google reCAPTCHA v3, vyžaduje Web3Forms Pro a vlastní klíče
//   none      – bez captchy
// Skript captchy se načte až ve chvíli, kdy návštěvník začne formulář vyplňovat.
import { site } from '../lib/content';

const key = site.web3forms_key;
const captcha = site.captcha === 'recaptcha' && site.recaptcha_site_key ? 'recaptcha' : site.captcha === 'none' ? 'none' : 'hcaptcha';
const HCAPTCHA_WEB3FORMS_FREE_KEY = '50b2fe65-b00b-4b9e-ad62-3ba471098be2';
const redirect = new URL('/dekujeme/', Astro.site).href;
---
{!key && <p class="notice">Formulář se zapne po vložení klíče Web3Forms v administraci (Nastavení webu).</p>}
<form
  class="enquiry"
  id="poptavka"
  method="POST"
  action="https://api.web3forms.com/submit"
  data-captcha={captcha}
  data-hcaptcha-key={HCAPTCHA_WEB3FORMS_FREE_KEY}
  data-recaptcha-key={site.recaptcha_site_key}
>
  <input type="hidden" name="access_key" value={key} />
  <input type="hidden" name="subject" value={`Zpráva z webu ${site.name}`} />
  <input type="hidden" name="from_name" value={`Web ${site.name}`} />
  <input type="hidden" name="redirect" value={redirect} />
  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="field row">
    <div class="field"><label for="f-name">Jméno a příjmení <span class="opt">(nepovinné)</span></label><input id="f-name" name="name" autocomplete="name" /></div>
    <div class="field"><label for="f-email">E-mail</label><input id="f-email" name="email" type="email" required autocomplete="email" /></div>
  </div>
  <div class="field"><label for="f-phone">Telefon <span class="opt">(nepovinné)</span></label><input id="f-phone" name="telefon" type="tel" autocomplete="tel" /></div>
  <div class="field"><label for="f-message">Zpráva</label><textarea id="f-message" name="message" rows="5" required placeholder="Na co se chcete zeptat?"></textarea></div>

  {captcha === 'hcaptcha' && <div class="captcha" data-captcha-box></div>}
  {captcha === 'recaptcha' && <input type="hidden" name="g-recaptcha-response" />}
  <p class="form-error" role="alert" hidden></p>

  <p class="small">
    Údaje z formuláře použijeme jen k odpovědi na vaši zprávu. Více v <a href="/ochrana-osobnich-udaju/">zásadách ochrany osobních údajů</a>.
    {captcha !== 'none' && <> Formulář chrání proti spamu {captcha === 'hcaptcha' ? 'hCaptcha' : 'Google reCAPTCHA'}, viz <a href="/cookies/">Cookies</a>.</>}
  </p>
  <div><button class="btn" type="submit" disabled={!key}>Odeslat zprávu</button></div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('form.enquiry');
  if (form) {
    const mode = form.dataset.captcha;
    const err = form.querySelector<HTMLElement>('.form-error')!;
    const showError = (msg: string) => { err.textContent = msg; err.hidden = false; };
    let loading = false;
    let widget: string | undefined;

    const load = (src: string) =>
      new Promise<void>((resolve, reject) => {
        const s = document.createElement('script');
        s.src = src; s.async = true; s.onload = () => resolve(); s.onerror = () => reject();
        document.head.appendChild(s);
      });

    // Načíst captchu až při první interakci s formulářem (žádné skripty třetích stran předem).
    const start = async () => {
      if (loading || mode === 'none') return;
      loading = true;
      try {
        if (mode === 'hcaptcha') {
          await load('https://js.hcaptcha.com/1/api.js?render=explicit&hl=cs&recaptchacompat=off');
          const box = form.querySelector<HTMLElement>('[data-captcha-box]')!;
          // @ts-ignore – globální objekt hCaptcha
          widget = window.hcaptcha.render(box, { sitekey: form.dataset.hcaptchaKey });
        } else if (mode === 'recaptcha') {
          await load(`https://www.google.com/recaptcha/api.js?render=${form.dataset.recaptchaKey}`);
        }
      } catch {
        showError('Ochranu formuláře se nepodařilo načíst. Zkuste stránku obnovit, nebo nám napište e-mail.');
      }
    };
    form.addEventListener('focusin', start, { once: true });
    form.addEventListener('pointerdown', start, { once: true });

    // Odeslání na pozadí: poděkování se ukáže přímo na místě formuláře, bez přechodu na jinou stránku.
    // Bez JavaScriptu formulář funguje klasicky a přesměruje na stránku /dekujeme/.
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const send = async () => {
      button.disabled = true;
      const label = button.textContent;
      button.textContent = 'Odesílám…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success !== false) {
          const done = document.createElement('div');
          done.className = 'form-done';
          done.setAttribute('role', 'status');
          done.tabIndex = -1;
          done.innerHTML = '<h3>Děkujeme za zprávu</h3><p>Vaši zprávu jsme dostali. Odpovíme vám e-mailem, obvykle do jednoho dne.</p>';
          form.replaceWith(done);
          done.focus();
          return;
        }
        showError(`Zprávu se nepodařilo odeslat${data.message ? ` (${data.message})` : ''}. Zkuste to prosím znovu, nebo nám napište e-mail.`);
      } catch {
        showError('Zprávu se nepodařilo odeslat. Zkontrolujte připojení a zkuste to znovu, nebo nám napište e-mail.');
      }
      button.disabled = false;
      button.textContent = label;
      // Ověření captchy jde použít jen jednou, po chybě ho obnovíme.
      // @ts-ignore
      if (mode === 'hcaptcha' && widget !== undefined && window.hcaptcha) window.hcaptcha.reset(widget);
      const rc = form.querySelector<HTMLInputElement>('input[name="g-recaptcha-response"]');
      if (rc) rc.value = '';
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      err.hidden = true;
      if (mode === 'hcaptcha') {
        // @ts-ignore
        const token = widget !== undefined && window.hcaptcha ? window.hcaptcha.getResponse(widget) : '';
        if (!token) { showError('Potvrďte prosím, že nejste robot.'); return; }
        send();
      } else if (mode === 'recaptcha') {
        const field = form.querySelector<HTMLInputElement>('input[name="g-recaptcha-response"]')!;
        // @ts-ignore – globální objekt reCAPTCHA
        const g = window.grecaptcha;
        if (!g) { showError('Ochrana formuláře se ještě načítá, zkuste to prosím za chvíli.'); return; }
        g.ready(() => g.execute(form.dataset.recaptchaKey, { action: 'submit' }).then((t: string) => { field.value = t; send(); }));
      } else {
        send();
      }
    });
  }
</script>

<style is:global>
  .form-done { background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--moss); border-radius: var(--radius); padding: 1.5rem; }
  .form-done:focus { outline: none; }
  .form-done h3 { margin-top: 0; }
  .form-done p:last-child { margin-bottom: 0; }
</style>
